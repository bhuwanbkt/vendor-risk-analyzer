# Application
APP_NAME=Vendor Risk Analyzer
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL / Neon
DATABASE_URL=postgresql://username:password@hostname/database

# ZITADEL / OIDC
ZITADEL_ISSUER=https://your-instance.zitadel.cloud
ZITADEL_CLIENT_ID=replace-with-your-client-id
ZITADEL_REDIRECT_URI=https://your-app.example/auth/callback
ZITADEL_POST_LOGOUT_URI=https://your-app.example/

# Used to sign our application session cookie
SESSION_SECRET=
ZITADEL_PROJECT_ID=
# Hosted deployments keep Secure cookies. For HTTP localhost, use .env.local.example.
SESSION_COOKIE_SECURE=true
# Opt-in JWT access tokens for external API clients; browser sessions still work.
API_BEARER_ENABLED=false

# Object Storage
OBJECT_STORAGE_ENDPOINT=
# Optional browser-facing endpoint for signed uploads when the internal hostname differs.
OBJECT_STORAGE_PUBLIC_ENDPOINT=
OBJECT_STORAGE_ADDRESSING_STYLE=auto
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=vendor-documents

GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

EMBEDDING_WORKER_ENABLED=true
EMBEDDING_WORKER_POLL_SECONDS=10
EMBEDDING_WORKER_BATCH_SIZE=20
EMBEDDING_WORKER_DELAY_SECONDS=4
EMBEDDING_WORKER_STALE_MINUTES=30

RISK_LLM_MODEL=gemini-3.8-flash
