# Copy this template to .env. These defaults support localhost development.
# For hosted deployments, use your database/storage settings, APP_ENV=production,
# HTTPS callback/logout URLs, and SESSION_COOKIE_SECURE=true.
APP_NAME=Vendor Risk Analyzer
APP_ENV=development
LOG_LEVEL=INFO

# Local Compose ports and example credentials
APP_PORT=8000
POSTGRES_PORT=5433
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PASSWORD=local-database-password
MINIO_ROOT_USER=local-storage-access
MINIO_ROOT_PASSWORD=local-storage-password

# Host endpoints for running Python outside Docker; Compose uses service names.
DATABASE_URL=postgresql://vendor_risk:local-database-password@localhost:5433/vendor_risk

# ZITADEL / OIDC
ZITADEL_ISSUER=https://your-instance.zitadel.cloud
ZITADEL_CLIENT_ID=replace-with-your-client-id
ZITADEL_PROJECT_ID=replace-with-your-project-id
ZITADEL_REDIRECT_URI=http://localhost:8000/auth/callback
ZITADEL_POST_LOGOUT_URI=http://localhost:8000/

# Replace with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-your-random-session-secret
# Compose overrides this for HTTP localhost. Set false for native HTTP development.
# Hosted deployments keep this true.
SESSION_COOKIE_SECURE=true
# Opt-in JWT access tokens for external API clients; browser sessions still work.
API_BEARER_ENABLED=false
# Optional Streamable HTTP MCP tools. Requires API_BEARER_ENABLED=true.
MCP_ENABLED=false
# Use the exact external /mcp URL; HTTPS is required outside development.
MCP_PUBLIC_URL=http://localhost:8000/mcp

# Object Storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# Optional browser-facing endpoint for signed uploads when the internal hostname differs.
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ADDRESSING_STYLE=path
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=local-storage-access
OBJECT_STORAGE_SECRET_ACCESS_KEY=local-storage-password
OBJECT_STORAGE_BUCKET=vendor-documents

GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Set true after adding your Gemini API key.
EMBEDDING_WORKER_ENABLED=false
EMBEDDING_WORKER_POLL_SECONDS=10
EMBEDDING_WORKER_BATCH_SIZE=20
EMBEDDING_WORKER_DELAY_SECONDS=4
EMBEDDING_WORKER_STALE_MINUTES=30

RISK_LLM_MODEL=gemini-3.8-flash
